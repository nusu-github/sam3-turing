# Optional external CUDA backends and their development probes.
if(SAM3_EXPERIMENT_TURING_ATTENTION)
  if(NOT SAM3_WITH_CUDA OR NOT EXISTS "${SAM3_TURING_DONOR}/csrc/cutlass/include/cute/tensor.hpp")
    message(FATAL_ERROR "Turing experiment needs CUDA and an external donor with CUTLASS submodule")
  endif()
  set(turing_headers "${CMAKE_CURRENT_BINARY_DIR}/turing-donor-headers")
  file(MAKE_DIRECTORY "${turing_headers}")
  foreach(header flash_fwd_kernel.h kernel_traits.h block_info.h utils.h mask.h)
    file(READ "${SAM3_TURING_DONOR}/csrc/flash_attn/src/${header}" contents)
    string(REPLACE "#include <torch/extension.h>" "// Python extension include omitted by local CMake adapter." contents "${contents}")
    file(CONFIGURE OUTPUT "${turing_headers}/${header}" CONTENT "@contents@" @ONLY)
  endforeach()
  # CUTLASS df18f5e: this wrapper calls a host-only virtual function. CUDA 13
  # diagnoses its unnecessary device annotation even though attention never uses it.
  file(READ "${SAM3_TURING_DONOR}/csrc/cutlass/include/cutlass/cuda_host_adapter.hpp" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  string(REPLACE "CUTLASS_HOST_DEVICE\n  Status memsetDevice(" "CUTLASS_HOST\n  Status memsetDevice(" contents "${contents}")
  file(MAKE_DIRECTORY "${turing_headers}/cutlass")
  file(CONFIGURE OUTPUT "${turing_headers}/cutlass/cuda_host_adapter.hpp" CONTENT "@contents@" @ONLY)
  add_library(sam3_turing_attention OBJECT tools/turing_attention.cu)
  target_include_directories(sam3_turing_attention PRIVATE include "${CMAKE_CURRENT_BINARY_DIR}"
    "${turing_headers}" "${SAM3_TURING_DONOR}/csrc/cutlass/include")
  target_link_libraries(sam3_turing_attention PRIVATE ${TORCH_LIBRARIES})
  target_compile_definitions(sam3_turing_attention PRIVATE sam3_native_EXPORTS)
  set_target_properties(sam3_turing_attention PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON
    CUDA_ARCHITECTURES 75 POSITION_INDEPENDENT_CODE ON)
  target_compile_options(sam3_turing_attention PRIVATE --expt-relaxed-constexpr --use_fast_math --ptxas-options=-v)
  if(MSVC)
    target_compile_options(sam3_turing_attention PRIVATE -Xcompiler=/Zc:preprocessor)
  endif()
  target_sources(sam3_native PRIVATE $<TARGET_OBJECTS:sam3_turing_attention>)
  set_property(SOURCE ${sam3_vision_sources} APPEND PROPERTY COMPILE_DEFINITIONS SAM3_EXPERIMENT_TURING_ATTENTION)
  if(SAM3_BUILD_DEVELOPMENT_TOOLS)
    add_executable(sam3_turing_attention_bench tools/turing_attention_bench.cpp)
    target_link_libraries(sam3_turing_attention_bench PRIVATE sam3_native)
  endif()
endif()
