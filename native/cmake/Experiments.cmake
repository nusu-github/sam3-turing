# Optional external CUDA backends and their development probes.
if(SAM3_EXPERIMENT_INT8_GEMM)
  if(NOT SAM3_WITH_CUDA OR NOT EXISTS "${SAM3_CUTLASS_ROOT}/include/cutlass/gemm/device/gemm.h")
    message(FATAL_ERROR "INT4 experiment requires CUDA and an external CUTLASS checkout")
  endif()
  # CUTLASS df18f5e: this wrapper calls a host-only virtual function. CUDA 13
  # diagnoses its unnecessary device annotation even though the GEMM never uses it.
  set(int8_headers "${CMAKE_CURRENT_BINARY_DIR}/int8-cutlass-headers")
  file(MAKE_DIRECTORY "${int8_headers}/cutlass")
  file(READ "${SAM3_CUTLASS_ROOT}/include/cutlass/cuda_host_adapter.hpp" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  string(REPLACE "CUTLASS_HOST_DEVICE\n  Status memsetDevice(" "CUTLASS_HOST\n  Status memsetDevice(" contents "${contents}")
  file(CONFIGURE OUTPUT "${int8_headers}/cutlass/cuda_host_adapter.hpp" CONTENT "@contents@" @ONLY)
  add_library(sam3_int4_experiment OBJECT tools/int4_experiment.cu)
  target_include_directories(sam3_int4_experiment PRIVATE include "${CMAKE_CURRENT_BINARY_DIR}" "${int8_headers}" "${SAM3_CUTLASS_ROOT}/include")
  target_link_libraries(sam3_int4_experiment PRIVATE ${TORCH_LIBRARIES})
  target_compile_definitions(sam3_int4_experiment PRIVATE sam3_native_EXPORTS)
  set_target_properties(sam3_int4_experiment PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES 75 POSITION_INDEPENDENT_CODE ON)
  target_compile_options(sam3_int4_experiment PRIVATE --expt-relaxed-constexpr --ptxas-options=-v)
  if(MSVC)
    target_compile_options(sam3_int4_experiment PRIVATE -Xcompiler=/Zc:preprocessor)
  endif()
  target_sources(sam3_native PRIVATE $<TARGET_OBJECTS:sam3_int4_experiment>)
  set_property(SOURCE ${sam3_vision_sources} APPEND PROPERTY COMPILE_DEFINITIONS SAM3_EXPERIMENT_INT8_GEMM)
  if(SAM3_BUILD_DEVELOPMENT_TOOLS)
    add_executable(sam3_int4_bench tools/int4_bench.cpp tools/approx_kernels.cu)
    target_link_libraries(sam3_int4_bench PRIVATE sam3_native)
    set_target_properties(sam3_int4_bench PROPERTIES CUDA_STANDARD 20 CUDA_ARCHITECTURES 75)
  endif()
endif()

option(SAM3_EXPERIMENT_KITCHEN_ATTENTION "Build external pinned ComfyKitchen INT8 attention experiment" OFF)
set(SAM3_KITCHEN_ROOT "" CACHE PATH "External ComfyKitchen CUDA backend root")
if(SAM3_EXPERIMENT_KITCHEN_ATTENTION)
  if(NOT SAM3_WITH_CUDA OR NOT EXISTS "${SAM3_KITCHEN_ROOT}/sage_attention/quant_qk_int8.cu")
    message(FATAL_ERROR "Kitchen experiment requires CUDA and the pinned external backend")
  endif()
  add_library(sam3_kitchen OBJECT tools/kitchen_attention.cu "${SAM3_KITCHEN_ROOT}/sage_attention/quant_qk_int8.cu" "${SAM3_KITCHEN_ROOT}/sage_attention/quant_v_int8.cu")
  target_include_directories(sam3_kitchen PRIVATE include "${CMAKE_CURRENT_BINARY_DIR}" "${SAM3_KITCHEN_ROOT}")
  target_link_libraries(sam3_kitchen PRIVATE ${TORCH_LIBRARIES})
  target_compile_definitions(sam3_kitchen PRIVATE sam3_native_EXPORTS)
  set_target_properties(sam3_kitchen PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES 75 POSITION_INDEPENDENT_CODE ON)
  target_compile_options(sam3_kitchen PRIVATE --expt-relaxed-constexpr --ptxas-options=-v)
  if(MSVC)
    target_compile_options(sam3_kitchen PRIVATE -Xcompiler=/Zc:preprocessor)
  endif()
  target_sources(sam3_native PRIVATE $<TARGET_OBJECTS:sam3_kitchen>)
  set_property(SOURCE ${sam3_vision_sources} APPEND PROPERTY COMPILE_DEFINITIONS SAM3_EXPERIMENT_KITCHEN_ATTENTION)
  if(SAM3_BUILD_DEVELOPMENT_TOOLS)
    add_executable(sam3_kitchen_bench tools/kitchen_bench.cpp)
    target_link_libraries(sam3_kitchen_bench PRIVATE sam3_native)
  endif()
endif()
