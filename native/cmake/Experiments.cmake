    target_link_libraries(sam3_int8_gemm_bench PRIVATE sam3_native)
    add_executable(sam3_int8_restore_bench tools/int8_restore_bench.cpp tools/approx_kernels.cu src/vision_fusion_cuda.cu)
    target_link_libraries(sam3_int8_restore_bench PRIVATE sam3_native)
